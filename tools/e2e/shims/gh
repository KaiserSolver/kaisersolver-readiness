#!/usr/bin/env bash
# Stand-in for the GitHub CLI: records every invocation to E2E_GH_LOG and answers the way an
# authenticated gh would, without reaching GitHub. `gh auth status` succeeds, `gh pr list --head`
# finds nothing, `gh pr create` prints a made-up PR URL. Nothing else is emulated on purpose.
set -euo pipefail
log="${E2E_GH_LOG:?E2E_GH_LOG is not set}"
printf '%s\n' "$*" >> "$log"
case "$1 ${2:-}" in
  "auth status") exit 0 ;;
  "pr list") exit 0 ;;
  "pr create") echo "https://github.invalid/e2e/kaisersolver-readiness/pull/1"; exit 0 ;;
  *) echo "gh shim: unexpected invocation: $*" >&2; exit 64 ;;
esac
